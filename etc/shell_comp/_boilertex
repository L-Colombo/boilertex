#compdef boilertex

autoload -U is-at-least

_boilertex() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_boilertex_commands" \
"*::: :->boilertex" \
&& ret=0
    case $state in
    (boilertex)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:boilertex-command-$line[1]:"
        case $line[1] in
            (generate)
_arguments "${_arguments_options[@]}" : \
'-g[Also initialize a Git repository with a default gitignore]' \
'--git[Also initialize a Git repository with a default gitignore]' \
'-h[Print help]' \
'--help[Print help]' \
':template -- The name of the template to be produced:_default' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(preview)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':template -- The name of the template to be previewed:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_boilertex__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:boilertex-help-command-$line[1]:"
        case $line[1] in
            (generate)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(preview)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_boilertex_commands] )) ||
_boilertex_commands() {
    local commands; commands=(
'generate:Generate boilerplate from a template' \
'list:' \
'preview:' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'boilertex commands' commands "$@"
}
(( $+functions[_boilertex__generate_commands] )) ||
_boilertex__generate_commands() {
    local commands; commands=()
    _describe -t commands 'boilertex generate commands' commands "$@"
}
(( $+functions[_boilertex__help_commands] )) ||
_boilertex__help_commands() {
    local commands; commands=(
'generate:Generate boilerplate from a template' \
'list:' \
'preview:' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'boilertex help commands' commands "$@"
}
(( $+functions[_boilertex__help__generate_commands] )) ||
_boilertex__help__generate_commands() {
    local commands; commands=()
    _describe -t commands 'boilertex help generate commands' commands "$@"
}
(( $+functions[_boilertex__help__help_commands] )) ||
_boilertex__help__help_commands() {
    local commands; commands=()
    _describe -t commands 'boilertex help help commands' commands "$@"
}
(( $+functions[_boilertex__help__list_commands] )) ||
_boilertex__help__list_commands() {
    local commands; commands=()
    _describe -t commands 'boilertex help list commands' commands "$@"
}
(( $+functions[_boilertex__help__preview_commands] )) ||
_boilertex__help__preview_commands() {
    local commands; commands=()
    _describe -t commands 'boilertex help preview commands' commands "$@"
}
(( $+functions[_boilertex__list_commands] )) ||
_boilertex__list_commands() {
    local commands; commands=()
    _describe -t commands 'boilertex list commands' commands "$@"
}
(( $+functions[_boilertex__preview_commands] )) ||
_boilertex__preview_commands() {
    local commands; commands=()
    _describe -t commands 'boilertex preview commands' commands "$@"
}

if [ "$funcstack[1]" = "_boilertex" ]; then
    _boilertex "$@"
else
    compdef _boilertex boilertex
fi
